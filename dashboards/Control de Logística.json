{
  "datasets": [
    {
      "name": "entregas_logistica",
      "displayName": "Entregas logísticas",
      "config": {
        "source": "logistica_dataco.gold.mart_entregas_modo_region",
        "measures": [
          {
            "name": "pedidos",
            "expr": "SUM(pedidos)"
          },
          {
            "name": "lineas",
            "expr": "SUM(lineas)"
          },
          {
            "name": "lineas_tardias",
            "expr": "SUM(lineas_tardias)"
          },
          {
            "name": "pct_tardias",
            "expr": "SUM(lineas_tardias) / SUM(lineas)",
            "comment": "Ratio 0-1 de líneas tardías sobre total de líneas, agregado como suma sobre suma.",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "dias_reales_medios",
            "expr": "SUM(dias_envio_real_medio * lineas) / SUM(lineas)",
            "comment": "Media ponderada por líneas de los días reales de envío.",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "dias_previstos_medios",
            "expr": "SUM(dias_envio_previsto_medio * lineas) / SUM(lineas)",
            "comment": "Media ponderada por líneas de los días previstos de envío.",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "desviacion_dias",
            "expr": "MEASURE(`dias_reales_medios`) - MEASURE(`dias_previstos_medios`)",
            "comment": "Días reales medios menos días previstos medios; positivo significa entregas más lentas de lo previsto.",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Entregas y retrasos por modo de envío y región de destino (excluye cancelados). Medias de días ponderadas por líneas; nunca promediar pct_tardias ni los *_medio de origen.",
        "dimensions": [
          {
            "expr": "shipping_mode"
          },
          {
            "expr": "order_region"
          }
        ]
      }
    },
    {
      "name": "entregas_dias_previsto_real",
      "displayName": "Días de envío: previsto vs real",
      "config": {
        "source": "SELECT shipping_mode, order_region, 'Previsto' AS tipo, dias_envio_previsto_medio AS dias, lineas FROM logistica_dataco.gold.mart_entregas_modo_region UNION ALL SELECT shipping_mode, order_region, 'Real' AS tipo, dias_envio_real_medio AS dias, lineas FROM logistica_dataco.gold.mart_entregas_modo_region",
        "measures": [
          {
            "name": "dias_medios",
            "expr": "SUM(dias * lineas) / SUM(lineas)",
            "comment": "Media ponderada por líneas de los días de envío (previstos o reales según tipo).",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Despliegue en filas (Previsto/Real) de los días de envío medios ponderados por líneas, para comparar previsto vs real por modo de envío en barras agrupadas.",
        "dimensions": [
          {
            "expr": "shipping_mode"
          },
          {
            "expr": "order_region"
          },
          {
            "expr": "tipo"
          }
        ]
      }
    }
  ],
