{
  "datasets": [
    {
      "name": "ventas_mensuales",
      "displayName": "Ventas mensuales",
      "config": {
        "source": "SELECT mes, pedidos, unidades, ventas_netas, descuentos, beneficio,\n       LAG(ventas_netas) OVER (ORDER BY mes) AS ventas_netas_prev\nFROM logistica_dataco.gold.mart_ventas_mensuales",
        "measures": [
          {
            "name": "ventas_netas",
            "expr": "SUM(ventas_netas)",
            "format": {
              "type": "currency",
              "currencyCode": "EUR",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "pedidos",
            "expr": "SUM(pedidos)"
          },
          {
            "name": "unidades",
            "expr": "SUM(unidades)"
          },
          {
            "name": "descuentos",
            "expr": "SUM(descuentos)",
            "format": {
              "type": "currency",
              "currencyCode": "EUR",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "beneficio",
            "expr": "SUM(beneficio)",
            "format": {
              "type": "currency",
              "currencyCode": "EUR",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "margen",
            "expr": "SUM(beneficio) / NULLIF(SUM(ventas_netas), 0)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "ticket_medio",
            "expr": "SUM(ventas_netas) / NULLIF(SUM(pedidos), 0)",
            "format": {
              "type": "currency",
              "currencyCode": "EUR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "descuentos_sobre_ventas",
            "expr": "SUM(descuentos) / NULLIF(SUM(ventas_netas), 0)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Ventas mensuales por mes de pedido (excluye cancelados). Margen, ticket medio y descuentos como ratios; variación mensual respecto al mes anterior.",
        "dimensions": [
          {
            "expr": "mes",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            }
          },
          {
            "name": "anio",
            "expr": "YEAR(mes)"
          },
          {
            "name": "variacion_ventas",
            "expr": "(source.ventas_netas - source.ventas_netas_prev) / NULLIF(source.ventas_netas_prev, 0)",
            "comment": "Variación de ventas netas respecto al mes anterior",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "tendencia",
            "expr": "CASE WHEN source.ventas_netas >= source.ventas_netas_prev THEN 'Alza' ELSE 'Baja' END"
          }
        ]
      }
    }
  ],
