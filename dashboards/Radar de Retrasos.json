{
  "datasets": [
    {
      "name": "retrasos_categoria_segmento",
      "displayName": "Retrasos por categoría y segmento",
      "config": {
        "source": "SELECT category_name,\n       customer_segment,\n       SUM(lineas) AS lineas,\n       SUM(lineas_tardias) AS lineas_tardias\nFROM logistica_dataco.gold.mart_retraso_categoria_segmento\nGROUP BY category_name, customer_segment\nHAVING SUM(lineas) >= min_lineas",
        "measures": [
          {
            "name": "lineas",
            "expr": "SUM(source.lineas)",
            "displayName": "Líneas"
          },
          {
            "name": "lineas_tardias",
            "expr": "SUM(source.lineas_tardias)",
            "displayName": "Líneas tardías"
          },
          {
            "displayName": "% de líneas tardías",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "pct_tardias",
            "expr": "SUM(source.lineas_tardias) * 1.0 / NULLIF(SUM(source.lineas), 0)",
            "comment": "SUM(lineas_tardias)/SUM(lineas) sobre el conjunto filtrado; nunca se promedia el pct_tardias de la tabla origen"
          },
          {
            "name": "num_categorias",
            "expr": "COUNT(DISTINCT source.category_name)",
            "displayName": "Nº de categorías"
          },
          {
            "displayName": "Brecha vs media global (p.p.)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "brecha_vs_global",
            "expr": "(MEASURE(pct_tardias) - ANY_VALUE(pct_global_tardias)) * 100",
            "comment": "% tardías del grupo menos % tardías global del conjunto filtrado, en puntos porcentuales"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "name": "category_name",
            "expr": "source.category_name",
            "displayName": "Categoría"
          },
          {
            "name": "customer_segment",
            "expr": "source.customer_segment",
            "displayName": "Segmento de cliente"
          },
          {
            "name": "pct_global_tardias",
            "expr": "SUM(source.lineas_tardias) OVER () * 1.0 / NULLIF(SUM(source.lineas) OVER (), 0)",
            "displayName": "% tardías global del conjunto filtrado"
          }
        ],
        "parameters": [
          {
            "name": "min_lineas",
            "dataType": "INT",
            "default": "0"
          }
        ]
      }
    },
    {
      "name": "umbral_opciones",
      "displayName": "Opciones de umbral mínimo de líneas",
      "config": {
        "version": "1.1",
        "source": "SELECT explode(array(0, 50, 100, 250, 500, 1000, 2500, 5000)) AS valor_umbral",
        "dimensions": [
          {
            "name": "valor_umbral",
            "expr": "valor_umbral",
            "displayName": "Mínimo de líneas"
          }
        ]
      }
    }
  ],
